# GitHub Access Token (public repo scope or fine-grained read-only)
GITHUB_TOKEN=your_github_token_here

# Hugging Face API Token (Inference API access)
HF_API_TOKEN=your_huggingface_token_here

# Redis URL for worker queue
REDIS_URL=redis://localhost:6379/0

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./health_auditor.db
