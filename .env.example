# Environment Configuration Template for GitHub Profile Health Auditor

# GitHub API Access (Optional: lifts rate limits for repo scanning)
GITHUB_TOKEN=your_github_personal_access_token_here

# AI Model Inference Services (Optional: used for AI synthesis & Copilot)
HF_API_TOKEN=your_huggingface_token_here
GROQ_API_TOKEN=your_groq_api_key_here

# Infrastructure Services (Local development defaults)
# Local Redis: redis://localhost:6379/0
# Upstash Redis: rediss://default:YOUR_PASSWORD@casual-doe-172271.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Local SQLite: sqlite:///./health_auditor.db
# Supabase Postgres: postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./health_auditor.db

# GitHub OAuth Login Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Security & Application Settings
JWT_SECRET_KEY=your_random_jwt_secret_key_here
JWT_SECRET=your_random_jwt_secret_key_here
ENVIRONMENT=development
ENABLE_DEMO_LOGIN=false

# Rate Limiting & Compute Guardrails
RATE_LIMIT_SCANS_PER_IP_24H=100
MAX_REPOS_PER_SCAN=10
SCAN_JOB_TIMEOUT_SECONDS=180
